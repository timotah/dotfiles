[global]
    ### Display ###
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 200)
    notification_limit = 7
    origin = top-right
    offset = (4, 4)
    indicate_hidden = yes
    shrink = no
    transparency = 1
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    frame_width = 2
    frame_color = "#64727D"
    separator_color = frame
    sort = yes
    layer = overlay

    ### Text ###
    font = JetBrainsMono Nerd Font Propo 11
    line_height = 1
    markup = yes
    format = "<b>%s</b>\n%b"
    alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    ellipsize = middle
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    highlight = "#81A1C1"
    progress_bar_height = 10
    progress_bar_frame_width = 0

    ### Icons ###
    icon_position = left
    max_icon_size = 32
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/
    sticky_history = yes
    history_length = 20

    ### Misc/Advanced ###
    dmenu = walker --dmenu 
    browser = /usr/bin/brave
    always_run_script = true
    title = Dunst
    class = Dunst
    force_xinerama = false
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+mod1+j

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#2B303BCC"
    foreground = "#FFFFFF"
    timeout = 4

[urgency_normal]
    background = "#2B303BCC"
    foreground = "#FFFFFF"
    timeout = 4

[urgency_critical]
    background = "#2B303BCC"
    foreground = "#D08770"
    timeout = 0
